# --- Credenciales y entorno ---
.env
.env.*
!.env.example
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Datos que NO se versionan ---
# Crudo y sintético: pueden contener datos personales o requerir revisión manual.
data/raw/*
data/synthetic/*
# Las capturas de OCR son sintéticas y se versionan para reproducir el CER.
# No agregues capturas reales con datos personales.
!data/**/.gitkeep

# --- Artefactos temporales ---
*.log
*.tmp
data/reportes_fase5/log_*.txt
data/reportes_fase5/*_parcial.jsonl
# Caché local de los splits ya sanitizados (se reconstruye desde data/splits/).
data/splits/sanitizado/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Documentación final local (no se sube al repositorio) ---
*.docx
VerifIA_Proyecto.docx
