# VerifIA — plantilla de configuración.
#
# Copia este archivo como `.env` en la raíz del proyecto y rellena NVIDIA_API_KEY.
#   PowerShell:  Copy-Item .env.example .env
# El archivo `.env` está en .gitignore: nunca se sube al repositorio ni se comparte.
#
# Fuente: VerifIA_memoria_proyecto.md §6.1 y §15.1.

# --- Credenciales (obligatorio) ---
# Se obtiene en https://build.nvidia.com (formato: nvapi-...)
NVIDIA_API_KEY=

# --- Modelos (API de NVIDIA, compatible con OpenAI) ---
# Nivel 2 de la cascada (default).
# Verificado el 17/11/2026: DeepSeek-V4.1-Flash devuelve HTTP 410 y no aparece en
# /v1/models. MiniMax-M3.1-Flash sí responde y devuelve JSON válido.
LLM_MODEL=minimaxai/minimax-m3.1-flash
# Revisor automático para el kappa (§8.7): distinto del Nivel 2.
# Verificado el 17/11/2026; JSON válido en 35.6–36.2 s con el prompt real.
# Mistral-Large-4 se descartó por latencia de 90–175 s (excede LLM_TIMEOUT_S).
LLM_REVIEWER_MODEL=meta/muse-glimmer-30b
# Generación del corpus sintético (Fase 2.2).
LLM_CORPUS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Parámetros de llamada (§15.1 #5) ---
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1300
# Intentos totales y espera inicial (2, 4, 8 s) ante 400/429/5xx/timeout.
LLM_MAX_REINTENTOS=3
LLM_RETRY_BASE_S=2
LLM_REASONING_EFFORT=low

# --- Endpoint (no suele cambiar) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OCR local (Fase 4, opcional) ---
# Solo si Tesseract no está en el PATH o spa.traineddata vive fuera de
# `tessdata`. En Docker la imagen ya fija TESSDATA_PREFIX.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Users\<usuario>\AppData\Local\tessdata
