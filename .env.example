# VerifIA — plantilla de configuración.
#
# Copia este archivo como `.env` en la raíz del proyecto y rellena NVIDIA_API_KEY.
#   PowerShell:  Copy-Item .env.example .env
# El archivo `.env` está en .gitignore: nunca se sube al repositorio ni se comparte.
#
# Fuente: VerifIA_memoria_proyecto.md §6.1 y §15.1.

# --- Credenciales (obligatorio) ---
# Se obtiene en https://build.nvidia.com (formato: nvapi-...)
NVIDIA_API_KEY=

# --- Modelos (API de NVIDIA, compatible con OpenAI) ---
# Nivel 2 de la cascada (default).
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
# Revisor automático para el kappa (§8.7): debe ser distinto del Nivel 2.
LLM_REVIEWER_MODEL=minimaxai/minimax-m3.1-flash
# Generación del corpus sintético (Fase 2.2).
LLM_CORPUS_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Parámetros de llamada (§15.1 #5) ---
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1200
LLM_REASONING_EFFORT=low

# --- Endpoint (no suele cambiar) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
