{"id": "man-paq-015", "texto": "DHL: Su envío internacional requiere el pago de derechos de aduana. Hágalo ahora en dhl-aduana.net.", "tipologia": "paqueteria_retenida", "senales_alerta": ["suplantacion", "enlace_sospechoso", "pago_anticipado"], "origen": "manual", "fuente_archivo": "paqueteria_manual.jsonl", "revision_autor": "confirmado", "version_corpus": "2.0"}
