{"id": "man-ext-036", "texto": "Tienes una cámara frente a tu casa. Si no pagas $2,500 la publicamos en la colonia.", "tipologia": "extorsion", "senales_alerta": ["amenaza", "pago_anticipado"], "origen": "manual", "fuente_archivo": "extorsion_manual.jsonl", "revision_autor": "confirmado", "version_corpus": "2.0"}
