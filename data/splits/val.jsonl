{"id": "man-ext-012", "texto": "Tengo acceso a tus cuentas. Transfiere $5,000 o publico tus datos.", "tipologia": "extorsion", "senales_alerta": ["amenaza", "pago_anticipado"], "origen": "manual", "fuente_archivo": "extorsion_manual.jsonl", "revision_autor": "confirmado", "version_corpus": "2.0"}
