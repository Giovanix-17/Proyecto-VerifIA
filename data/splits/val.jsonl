{"id": "man-paq-007", "texto": "Tu paquete de Temu está retenido. Confirma tus datos y paga $49 en paquete-seguro.com.", "tipologia": "paqueteria_retenida", "senales_alerta": ["enlace_sospechoso", "pago_anticipado", "solicitud_datos"], "origen": "manual", "fuente_archivo": "paqueteria_manual.jsonl", "revision_autor": "confirmado", "version_corpus": "2.0"}
